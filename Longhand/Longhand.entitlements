<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the widget extension, which reads the library snapshot
	     the app writes there. Nothing else is in the group container. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.shpala.Longhand</string>
	</array>
</dict>
</plist>
